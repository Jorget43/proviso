{
  "expo": {
    "name": "Proviso",
    "slug": "proviso",
    "scheme": "proviso",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F5F2EC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.proviso.dev"
    },
    "android": {
      "package": "app.proviso.dev"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-secure-store",
      "expo-sharing",
      "expo-dev-client"
    ]
  }
}
