{
  // No "dom" in lib, and no Node types: sync must run unchanged in Node,
  // browsers and React Native (docs/architecture.md, D7). A platform API
  // slipping in fails the typecheck.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ES2023.Array"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"]
}
